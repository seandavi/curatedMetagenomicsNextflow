/*
 * Harvard FASRC (Cannon) profile (SLURM)
 *
 * Mirrors the anvil/alpine/bridges2 profiles. The nextflow_telemetry submit
 * template overrides executor, clusterOptions (partitions: wrapper on
 * `huttenhower`, tasks on `hsph,shared`), workDir, store_dir and the store bind
 * at dispatch time; this profile is what a run needs beyond that.
 *
 * `hsph` nodes are 112 cores / 1 TB, `shared` nodes 48 cores / 192 GB; both cap
 * a job at 3 days (checked 2026-11-05). Retries scale memory x task.attempt, so
 * cap at what a `shared` node holds, which keeps every retry eligible for both
 * partitions. Needs Nextflow >= 23.04.
 */

profiles {
    fasrc {
        process.executor  = 'slurm'
        process.queueSize = 100
        process.time      = '24h'
        process.resourceLimits = [ memory: 180.GB, cpus: 48, time: 24.h ]

        workDir = 'work'
        params.store_dir = '/n/holylfs05/LABS/huttenhower_lab/Users/seandavi/cmgd/store'

        singularity.runOptions = "--bind /n/holylfs05/LABS/huttenhower_lab/Users/seandavi/cmgd/store:/keep/store/"
    }
}
