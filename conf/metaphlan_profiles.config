/*
 * MetaPhlAn profile registry (ADR-0018)
 *
 * A profile is a named, pinned unit: the container MetaPhlAn runs in, the
 * MetaPhlAn version, the index, and the CLI spellings that differ between
 * MetaPhlAn releases. The main taxonomy pass (`params.metaphlan_profile`) and
 * every HUMAnN bundle (`metaphlan_profile` field in
 * conf/humann_bundles.config) refer to a profile by name, so version facts live
 * here and nowhere else. An unknown name fails at workflow start, listing the
 * valid ones.
 *
 * Fields:
 *   container       container for the index install and every MetaPhlAn step
 *                   that uses this profile
 *   version         MetaPhlAn version (provenance; the container is what
 *                   actually pins it)
 *   index           MetaPhlAn index. It is also the storeDir cache key
 *                   (`<store_dir>/metaphlan/<index>/`), so a profile and any
 *                   other profile with the same index share one installed DB
 *   db_option       option that points MetaPhlAn at the database directory:
 *                   `--bowtie2db` through 4.1.x, `--db_dir` from 4.2
 *   map_option      option that writes the alignment map file: `--bowtie2out`
 *                   through 4.1.x, `--mapout` from 4.2 (4.2 rejects the old name)
 *   map_input_type  `--input_type` value that reads that map file back:
 *                   `bowtie2out` through 4.1.x, `mapout` from 4.2
 *
 * Adding a profile is one more entry here.
 */

params {
    metaphlan_profiles = [
        // The main taxonomy pass. The container is the pipeline's base image
        // (`process.container` in conf/base.config); the two must stay equal, so
        // the published taxonomy is unchanged by how the pin is spelled.
        // MetaPhlAn 4.2.6's `--version` still prints 4.2.5 (upstream did not
        // bump it), so manifests record 4.2.5 for this profile.
        'mpa4.2.6_vJan26': [
            container     : 'docker://ghcr.io/seandavi/curatedmetagenomics:metaphlan4.2.6',
            version       : '4.2.6',
            index         : 'mpa_vJan26_CHOCOPhlAnSGB_202605',
            db_option     : '--db_dir',
            map_option    : '--mapout',
            map_input_type: 'mapout',
        ],
        // The 2.2.x main pass (the previous base image, with HUMAnN 4.0.0a1
        // still in it). Kept so 2.2.x outputs can be reproduced.
        'mpa4.2.2_vJan25': [
            container     : 'docker://seandavi/curatedmetagenomics:metaphlan4.2.2',
            version       : '4.2.2',
            index         : 'mpa_vJan25_CHOCOPhlAnSGB_202503',
            db_option     : '--db_dir',
            map_option    : '--mapout',
            map_input_type: 'mapout',
        ],
        // For HUMAnN 3.9, which rejects any profile whose header lacks `vJun23`
        // (humann/config.py: metaphlan_v4_db_version; humann/search/prescreen.py).
        // 4.1.1 rather than 4.1.2: 4.1.2's `--version` prints an extra line,
        // which breaks HUMAnN 4.0.0a1's version parse.
        'mpa4.1.1_vJun23': [
            container     : 'docker://quay.io/biocontainers/metaphlan:4.1.1--pyhdfd78af_0',
            version       : '4.1.1',
            index         : 'mpa_vJun23_CHOCOPhlAnSGB_202307',
            db_option     : '--bowtie2db',
            map_option    : '--bowtie2out',
            map_input_type: 'bowtie2out',
        ],
        // For HUMAnN 4.0.0 alpha 1, which requires the vOct22_CHOCOPhlAnSGB_202403
        // profile (humann/config.py@4.0.0.alpha.1-final) and calls MetaPhlAn with
        // 4.1-era options.
        'mpa4.1.1_vOct22': [
            container     : 'docker://quay.io/biocontainers/metaphlan:4.1.1--pyhdfd78af_0',
            version       : '4.1.1',
            index         : 'mpa_vOct22_CHOCOPhlAnSGB_202403',
            db_option     : '--bowtie2db',
            map_option    : '--bowtie2out',
            map_input_type: 'bowtie2out',
        ],
    ]
}
