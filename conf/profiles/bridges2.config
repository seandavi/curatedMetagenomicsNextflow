/*
 * PSC Bridges-2 profile (SLURM, RM-shared)
 *
 * Mirrors the anvil/alpine profiles. The nextflow_telemetry submit template
 * overrides executor, clusterOptions, workDir, store_dir and the store bind at
 * dispatch time; this profile is what a run needs beyond that.
 *
 * RM-shared rejects any job above 2000 MB per core and caps a job at 64 cores
 * and 3 days (checked 2026-10-13). The telemetry template raises each task's
 * --cpus-per-task to ceil(memory / 2000 MB) (client yaml max_mem_per_cpu_mb),
 * so memory is the binding limit: 120 GiB needs 62 cores. Retries scale memory
 * x task.attempt, so cap below that. Needs Nextflow >= 23.04.
 */

profiles {
    bridges2 {
        process.executor  = 'slurm'
        process.queueSize = 100
        process.time      = '24h'
        process.resourceLimits = [ memory: 120.GB, cpus: 64, time: 24.h ]

        workDir = 'work'
        params.store_dir = '/ocean/projects/cis260344p/seandavi/cmgd/store'

        singularity.runOptions = "--bind /ocean/projects/cis260344p/seandavi/cmgd/store:/keep/store/"
    }
}
