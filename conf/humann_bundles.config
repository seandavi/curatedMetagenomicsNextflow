/*
 * HUMAnN bundle registry (ADR-0016, amended by ADR-0018)
 *
 * A bundle is a named, tested set of pins that must move together: the HUMAnN
 * container, the MetaPhlAn profile HUMAnN consumes, and the ChocoPhlAn / UniRef /
 * utility-mapping database names. `params.humann_bundle` selects one; there are
 * deliberately no free-form per-tool version parameters, because compatibility
 * is a single upstream pin per HUMAnN release.
 *
 * The MetaPhlAn half of a bundle is a *profile name* from
 * conf/metaphlan_profiles.config (container, version, index and version-specific
 * CLI options live there, once). When the bundle's profile differs from the main
 * `params.metaphlan_profile`, the HUMAnN pass runs its own MetaPhlAn so the
 * published taxonomy is never constrained by what HUMAnN can read. When the
 * profiles are equal (a HUMAnN release that reads the main index), HUMAnN reuses the main pass's
 * full-depth profile and no second MetaPhlAn runs.
 *
 * Fields:
 *   humann_container     container for the humann DB processes and `humann`
 *   metaphlan_profile    name of the MetaPhlAn profile HUMAnN's taxonomic
 *                        profile is made with
 *   chocophlan, uniref, utility_mapping
 *                        `humann_databases --download <db> <name>` build names
 *   humann_utility_db_option
 *                        `humann` option that points at the utility-mapping DB,
 *                        or null when that HUMAnN release has none (3.9 reads
 *                        its pathway files from the package; 4.0 alpha moved
 *                        them into the utility DB and added `--utility-database`)
 *
 * Adding a bundle is one more entry here (plus a profile, if it needs a
 * MetaPhlAn that is not registered yet). Output files of HUMAnN versions with
 * different file sets are published under their native names, so no process
 * changes are needed.
 */

params {
    humann_bundles = [
        // HUMAnN 3.9 rejects any profile whose header lacks `vJun23`
        // (humann/config.py: metaphlan_v4_db_version; humann/search/prescreen.py),
        // so it needs MetaPhlAn 4.1.x with the vJun23 index rather than the
        // 4.2.6 / vJan26 main pass.
        'humann3.9': [
            humann_container   : 'docker://quay.io/biocontainers/humann:3.9--py312hdfd78af_0',
            metaphlan_profile  : 'mpa4.1.1_vJun23',
            chocophlan         : 'full',
            uniref             : 'uniref90_ec_filtered_diamond',
            utility_mapping    : 'full',
            humann_utility_db_option: null,
        ],
        // HUMAnN 4.0.0 alpha 1 requires the vOct22_CHOCOPhlAnSGB_202403 profile
        // (humann/config.py@4.0.0.alpha.1-final) and still calls MetaPhlAn with
        // 4.1-era options, so it also runs MetaPhlAn 4.1.1. Not packaged usably
        // upstream; the image is built from docker/humann4a (ADR-0017). DB build
        // names are from `humann_databases --available` in that image.
        'humann4.0.0a1': [
            humann_container   : 'docker://ghcr.io/seandavi/humann:4.0.0a1',
            metaphlan_profile  : 'mpa4.1.1_vOct22',
            chocophlan         : 'full',
            uniref             : 'uniref90_ec_filtered_diamond',
            utility_mapping    : 'full',
            humann_utility_db_option: '--utility-database',
        ],
    ]
}
