/*
 * Rollback profile
 *
 * Emergency fallback that points the pipeline back at the v1 self-hosted
 * telemetry server (nf-telemetry.cancerdatasci.org) if the v2 Cloudflare
 * Worker hiccups. v1 is retiring (seandavi/nextflow_telemetry v2 cutover);
 * once it is decommissioned this profile loses its meaning and can be
 * removed. The legacy Cloud Run URL it used to target no longer resolves.
 *
 * Combine with site profiles as needed, e.g.:
 *   nextflow run ... -profile alpine,rollback
 */

profiles {
    rollback {
        params.api_url = 'https://nf-telemetry.cancerdatasci.org/api'
        weblog.url     = 'https://nf-telemetry.cancerdatasci.org/telemetry'
    }
}
