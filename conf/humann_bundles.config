/*
 * HUMAnN bundle registry (ADR-0016)
 *
 * A bundle is a named, tested set of pins that must move together: the
 * HUMAnN and MetaPhlAn containers, the MetaPhlAn version and index HUMAnN
 * consumes, and the ChocoPhlAn / UniRef / utility-mapping database names.
 * `params.humann_bundle` selects one; there are deliberately no free-form
 * per-tool version parameters, because compatibility is a single upstream pin
 * per HUMAnN release.
 *
 * The HUMAnN pass runs its own MetaPhlAn (independent of the main
 * `params.metaphlan_index` pass) so that the published MetaPhlAn taxonomy is
 * never constrained by what HUMAnN can read.
 *
 * Fields:
 *   humann_container     container for the humann DB processes and `humann`
 *   metaphlan_container  container for the bundle's MetaPhlAn index install and
 *                        `metaphlan_for_humann`
 *   metaphlan_version    MetaPhlAn version the bundle expects (provenance; the
 *                        container is what actually pins it)
 *   metaphlan_index      MetaPhlAn index the HUMAnN profile is made with
 *   chocophlan, uniref, utility_mapping
 *                        `humann_databases --download <db> <name>` build names
 *
 * Adding a bundle is one more entry here. Output files of HUMAnN versions with
 * different file sets are published under their native names, so no process
 * changes are needed.
 */

params {
    humann_bundles = [
        // HUMAnN 3.9 rejects any profile whose header lacks `vJun23`
        // (humann/config.py: metaphlan_v4_db_version; humann/search/prescreen.py),
        // so it needs MetaPhlAn 4.1.x with the vJun23 index rather than the
        // 4.2.2 / vJan25 main pass.
        'humann3.9': [
            humann_container   : 'docker://quay.io/biocontainers/humann:3.9--py312hdfd78af_0',
            metaphlan_container: 'docker://quay.io/biocontainers/metaphlan:4.1.1--pyhdfd78af_0',
            metaphlan_version  : '4.1.1',
            metaphlan_index    : 'mpa_vJun23_CHOCOPhlAnSGB_202307',
            chocophlan         : 'full',
            uniref             : 'uniref90_ec_filtered_diamond',
            utility_mapping    : 'full',
        ],
        // HUMAnN 4.0.0a1 rejects profiles whose header lacks
        // `vOct22_CHOCOPhlAnSGB_202403` (humann/config.py@4.0.0.alpha.1-final:
        // metaphlan_v4_db_version). That index is on the MetaPhlAn database
        // server and is installed/run by the same MetaPhlAn 4.1.1 image as
        // humann3.9. HUMAnN 4a is not on bioconda, so its image is built from
        // docker/humann4a/Dockerfile. DB names are from
        // `humann_databases --available` in that image (the 4a builds of
        // `full` / `uniref90_ec_filtered_diamond` are v4_alpha tarballs).
        // Outputs use 4a's native names (out_2_genefamilies, out_3_reactions,
        // out_4_pathabundance; 4.0.0a1 writes no _5_pathcoverage table).
        'humann4.0.0a1': [
            humann_container   : 'docker://seandavi/curatedmetagenomics:humann4.0.0a1',
            metaphlan_container: 'docker://quay.io/biocontainers/metaphlan:4.1.1--pyhdfd78af_0',
            metaphlan_version  : '4.1.1',
            metaphlan_index    : 'mpa_vOct22_CHOCOPhlAnSGB_202403',
            chocophlan         : 'full',
            uniref             : 'uniref90_ec_filtered_diamond',
            utility_mapping    : 'full',
        ],
    ]
}
