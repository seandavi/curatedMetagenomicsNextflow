/*
 * R2 storage profile (ADR-0015)
 *
 * `r2` — publish pipeline OUTPUTS to the Cloudflare R2 bucket `cmgd-raw`
 *        through R2's S3 API. Like `gcs`, it only moves outputs: workDir stays
 *        wherever the compute profile put it (local scratch on HPC).
 *
 *          -profile alpine,r2    # HPC compute, local workDir, R2 output
 *
 *        Outputs land at s3://cmgd-raw/<workflow-name>/<workflow-version>/
 *        <sample_id>/<step>/ (nextflow_telemetry ADR 0008, storage-layout.md).
 *
 * Only the Nextflow driver writes to R2 (the publishDir copy), so only the
 * driver needs credentials. They come from the environment, never from this
 * file:
 *
 *   R2_ACCOUNT_ID         Cloudflare account id (the endpoint host)
 *   R2_ACCESS_KEY_ID      R2 S3 access key id
 *   R2_SECRET_ACCESS_KEY  R2 S3 secret access key
 *
 * The cluster submit template sources them from ~/.nf_tel.r2 (filled from GCP
 * Secret Manager `cdsci-r2-*`) and refuses to start an r2 run without them.
 * Non-standard names, not AWS_*, so the awscli calls inside task containers
 * never pick them up by accident.
 */

profiles {
    r2 {
        params.publish_base_dir = 's3://cmgd-raw'
        params.publish_mode     = 'copy'

        aws.accessKey              = System.getenv('R2_ACCESS_KEY_ID')
        aws.secretKey              = System.getenv('R2_SECRET_ACCESS_KEY')
        aws.region                 = 'us-east-1'   // R2 treats it as 'auto'; AWS SDK v1 (Nextflow 24.04) rejects 'auto'
        aws.client.endpoint        = "https://${System.getenv('R2_ACCOUNT_ID')}.r2.cloudflarestorage.com"
        aws.client.s3PathStyleAccess = true
    }
}
