nextflow_pipeline {

    name "Top-level pipeline structure"
    tag "pipeline"
    tag "stub"

    script "../main.nf"

    test("Single-sample stub run completes through MARK_COMPLETE") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
            }
        }

        then {
            assert workflow.success
            assert workflow.failed == false
            assert workflow.exitStatus == 0
            assert workflow.errorReport == null || workflow.errorReport.isEmpty()
        }
    }

    test("Single-sample stub run completes with Kraken disabled") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
                skip_kraken = true
            }
        }

        then {
            assert workflow.success
            assert workflow.failed == false
            assert workflow.exitStatus == 0
            assert workflow.errorReport == null || workflow.errorReport.isEmpty()
        }
    }

    test("Single-sample stub run completes with resistome disabled") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
                skip_resistome = true
            }
        }

        then {
            assert workflow.success
            assert workflow.failed == false
            assert workflow.exitStatus == 0
            assert workflow.errorReport == null || workflow.errorReport.isEmpty()
        }
    }

    test("Single-sample stub run completes with FastQC disabled") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
                skip_fastqc = true
            }
        }

        then {
            assert workflow.success
            assert workflow.failed == false
            assert workflow.exitStatus == 0
            assert workflow.errorReport == null || workflow.errorReport.isEmpty()
        }
    }

    test("Missing sample arguments fails fast with a clear error") {

        when {
            params {
                skip_humann = true
            }
        }

        then {
            assert workflow.failed
            // The input-contract guard is a workflow-level error(), so the
            // message surfaces on stdout rather than in a process errorReport.
            assert workflow.stdout.any { it.contains("Either metadata_tsv or run_ids/sample_id must be provided") }
        }
    }

    test("databases_only runs only database processes and needs no sample input") {

        when {
            params {
                databases_only = true
                skip_humann = true
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0
            // Tracing is disabled in nf-test; process names come from the
            // pipeline's "[PROCESS xx/yyyyyy] <name> (<tag>)" stdout lines.
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.size() > 0
            assert names.every { it.startsWith("DATABASES:") }
            assert names.any { it.startsWith("DATABASES:install_metaphlan_db") }
            assert names.any { it.startsWith("DATABASES:kraken_db") }
            assert names.any { it.startsWith("DATABASES:card_kma_db") }
            // HUMAnN databases are gated on skip_humann (default true)
            assert !names.any { it.contains("chocophlan_db") || it.contains("uniref_db") || it.contains("utility_mapping_db") }
            assert !names.any { it.contains("fasterq_dump") || it.startsWith("kneaddata ") || it.contains("MARK_COMPLETE") }
        }
    }

    test("databases_only respects skip_kraken and skip_resistome") {

        when {
            params {
                databases_only = true
                skip_humann = true
                skip_kraken = true
                skip_resistome = true
            }
        }

        then {
            assert workflow.success
            // Tracing is disabled in nf-test; process names come from the
            // pipeline's "[PROCESS xx/yyyyyy] <name> (<tag>)" stdout lines.
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.any { it.startsWith("DATABASES:install_metaphlan_db") }
            assert names.any { it.startsWith("DATABASES:kneaddata_human_database") }
            assert names.any { it.startsWith("DATABASES:kneaddata_mouse_database") }
            assert !names.any { it.contains("kraken_db") || it.contains("card_db") || it.contains("card_kma_db") }
        }
    }

    test("databases_only stages HUMAnN databases only when skip_humann is false") {

        when {
            params {
                databases_only = true
                skip_humann = false
            }
        }

        then {
            assert workflow.success
            // Tracing is disabled in nf-test; process names come from the
            // pipeline's "[PROCESS xx/yyyyyy] <name> (<tag>)" stdout lines.
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.any { it.startsWith("DATABASES:chocophlan_db") }
            assert names.any { it.startsWith("DATABASES:uniref_db") }
            assert names.any { it.startsWith("DATABASES:utility_mapping_db") }
        }
    }

    test("Normal run skips HUMAnN databases when skip_humann is true") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
            }
        }

        then {
            assert workflow.success
            // Tracing is disabled in nf-test; process names come from the
            // pipeline's "[PROCESS xx/yyyyyy] <name> (<tag>)" stdout lines.
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert !names.any { it.contains("chocophlan_db") || it.contains("uniref_db") || it.contains("utility_mapping_db") }
        }
    }

    test("Normal run with HUMAnN enabled stubs through the DATABASES wiring") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
            }
        }

        then {
            assert workflow.success
            // Tracing is disabled in nf-test; process names come from the
            // pipeline's "[PROCESS xx/yyyyyy] <name> (<tag>)" stdout lines.
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.any { it.startsWith("DATABASES:chocophlan_db") }
            assert names.any { it.startsWith("HUMANN:humann") }
        }
    }

    test("Normal run with HUMAnN enabled runs the bundle subworkflow on the full branch only") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
            }
        }

        then {
            assert workflow.success
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.any { it.startsWith("DATABASES:metaphlan_db_humann") }
            assert names.any { it.startsWith("DATABASES:uniref_db") }
            assert names.any { it.startsWith("DATABASES:utility_mapping_db") }
            assert names.count { it.startsWith("HUMANN:metaphlan_for_humann") } == 1
            assert !names.any { it.contains("humann_reuse_metaphlan") }
            assert names.count { it.startsWith("DATABASES:install_metaphlan_db") } == 1
            assert names.count { it.startsWith("DATABASES:metaphlan_db_humann") } == 1
            assert names.count { it.startsWith("HUMANN:humann") } == 1
            // The main MetaPhlAn pass is unchanged: one full + one rarefied.
            assert names.count { it.startsWith("metaphlan_unknown_viruses_lists_full") } == 1
            assert names.count { it.startsWith("metaphlan_unknown_viruses_lists_rarefied") } == 1
        }
    }

    test("HUMAnN publishes under humann/<bundle>/ with the MetaPhlAn profile in metaphlan/") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                publish_dir = "$outputDir/pub"
            }
        }

        then {
            assert workflow.success
            def root = "$outputDir/pub/TEST_SAMPLE"
            assert file("$root/humann/humann3.9/metaphlan/metaphlan_rel_ab_w_read_stats.tsv").exists()
            assert file("$root/humann/humann3.9/out_genefamilies.tsv.gz").exists()
            assert file("$root/humann/humann3.9/out_pathabundance.tsv.gz").exists()
            // Main taxonomy publish paths are unchanged.
            assert file("$root/full_data/metaphlan_lists").isDirectory()
            assert file("$root/full_data/metaphlan_markers").isDirectory()
            assert file("$root/rarefied_data/metaphlan_lists").isDirectory()
            assert !file("$root/full_data/humann").exists()
        }
    }

    test("Unknown humann_bundle fails fast listing the valid names when HUMAnN is enabled") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                humann_bundle = "no-such-bundle"
            }
        }

        then {
            assert workflow.failed
            def out = (workflow.stdout + workflow.stderr).join("\n")
            assert out.contains("Unknown humann_bundle 'no-such-bundle'")
            assert out.contains("Valid bundles: humann3.9")
        }
    }

    test("Unknown humann_bundle also fails databases_only when HUMAnN is enabled") {

        when {
            params {
                databases_only = true
                skip_humann = false
                humann_bundle = "no-such-bundle"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join("\n").contains("Valid bundles: humann3.9")
        }
    }

    test("humann_bundle is not validated when HUMAnN is skipped") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
                humann_bundle = "no-such-bundle"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("Unknown metaphlan_profile fails fast listing the valid names, even when HUMAnN is skipped") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = true
                metaphlan_profile = "no-such-profile"
            }
        }

        then {
            assert workflow.failed
            def out = (workflow.stdout + workflow.stderr).join("\n")
            assert out.contains("Unknown metaphlan_profile 'no-such-profile'")
            assert out.contains("Valid profiles: mpa4.2.2_vJan25, mpa4.1.1_vJun23, mpa4.1.1_vOct22")
        }
    }

    test("Unknown metaphlan_profile also fails databases_only") {

        when {
            params {
                databases_only = true
                skip_humann = true
                metaphlan_profile = "no-such-profile"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join("\n").contains("Unknown metaphlan_profile 'no-such-profile'")
        }
    }

    test("A bundle naming an unregistered MetaPhlAn profile fails fast listing the valid names") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                humann_bundle = "test-bad-profile"
                humann_bundles = [
                    "test-bad-profile": [
                        humann_container: "unused",
                        metaphlan_profile: "no-such-profile",
                        chocophlan: "full",
                        uniref: "uniref90_ec_filtered_diamond",
                        utility_mapping: "full",
                        humann_utility_db_option: null,
                    ]
                ]
            }
        }

        then {
            assert workflow.failed
            def out = (workflow.stdout + workflow.stderr).join("\n")
            assert out.contains("humann_bundle 'test-bad-profile' names unknown metaphlan_profile 'no-such-profile'")
            assert out.contains("Valid profiles: mpa4.2.2_vJan25")
        }
    }

    // Test-only bundle (not a registry entry) whose MetaPhlAn profile equals the
    // main profile: HUMAnN reuses the main pass (ADR-0018).
    test("Bundle whose profile equals the main profile reuses the main pass: no second MetaPhlAn run or index install") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                publish_dir = "$outputDir/pub"
                humann_bundle = "test-reuse"
                humann_bundles = [
                    "test-reuse": [
                        humann_container: "unused",
                        metaphlan_profile: "mpa4.2.2_vJan25",
                        chocophlan: "full",
                        uniref: "uniref90_ec_filtered_diamond",
                        utility_mapping: "full",
                        humann_utility_db_option: "--utility-database",
                    ]
                ]
            }
        }

        then {
            assert workflow.success
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert !names.any { it.contains("metaphlan_for_humann") }
            assert !names.any { it.contains("metaphlan_db_humann") }
            assert names.count { it.startsWith("DATABASES:install_metaphlan_db") } == 1
            assert names.count { it.startsWith("HUMANN:humann_reuse_metaphlan") } == 1
            assert names.count { it.startsWith("HUMANN:humann (") } == 1
            // The provenance layout is the same as for a bundle with its own pass.
            def root = "$outputDir/pub/TEST_SAMPLE"
            assert file("$root/humann/test-reuse/metaphlan/metaphlan_rel_ab_w_read_stats.tsv").exists()
            assert file("$root/humann/test-reuse/out_genefamilies.tsv.gz").exists()
            // Main taxonomy publish paths are unchanged.
            assert file("$root/full_data/metaphlan_markers").isDirectory()
            assert !file("$root/full_data/humann").exists()
        }
    }

    test("databases_only with a reusing bundle installs one MetaPhlAn index, not two") {

        when {
            params {
                databases_only = true
                skip_humann = false
                humann_bundle = "test-reuse"
                humann_bundles = [
                    "test-reuse": [
                        humann_container: "unused",
                        metaphlan_profile: "mpa4.2.2_vJan25",
                        chocophlan: "full",
                        uniref: "uniref90_ec_filtered_diamond",
                        utility_mapping: "full",
                        humann_utility_db_option: null,
                    ]
                ]
            }
        }

        then {
            assert workflow.success
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.count { it.startsWith("DATABASES:install_metaphlan_db") } == 1
            assert !names.any { it.contains("metaphlan_db_humann") }
            assert names.any { it.startsWith("DATABASES:chocophlan_db") }
        }
    }

    test("humann4.0.0a1 stubs through its own vOct22 MetaPhlAn pass") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                humann_bundle = "humann4.0.0a1"
            }
        }

        then {
            assert workflow.success
            def names = workflow.stdout.findAll { it.startsWith("[PROCESS ") }
                .collect { it.replaceFirst(/^\[PROCESS [^\]]*\]\s*/, "") }
            assert names.count { it.startsWith("DATABASES:install_metaphlan_db") } == 1
            assert names.count { it.startsWith("DATABASES:metaphlan_db_humann") } == 1
            assert names.count { it.startsWith("HUMANN:metaphlan_for_humann") } == 1
            assert !names.any { it.contains("humann_reuse_metaphlan") }
        }
    }

    test("Manifest builder keeps main and HUMAnN-pass versions distinct and records the bundle") {

        when {
            params {
                sample_id = "TEST_SAMPLE"
                run_ids = "SRR000001"
                skip_humann = false
                publish_dir = "$outputDir/pub"
            }
        }

        then {
            assert workflow.success

            // The stub sample_manifest does not run build_manifest.py, so run it
            // on the real collated versions the stubbed pipeline produced (which
            // carry the HUMAnN-pass keys) plus a main-pass versions file, in the
            // order the pipeline's glob would merge them.
            def found = []
            new File("$launchDir/work").eachFileRecurse(groovy.io.FileType.FILES) {
                if (it.name == "versions_collated.yml") found << it
            }
            assert found.size() == 1

            def dir = new File("$outputDir/manifest_check")
            dir.mkdirs()
            // 'versions_a_main.yml' sorts before the collated file, so a naive
            // last-file-wins merge would let a colliding key be overwritten.
            new File(dir, "versions_a_main.yml").text = "versions:\n    metaphlan: 4.2.2\n    bowtie2: 2.5.4\n"
            new File(dir, "versions_z_collated.yml").text = found[0].text
            new File(dir, "reads.fastq").text = "@r1\nACGT\n+\nIIII\n"

            def proc = ["python3", "${projectDir}/bin/build_manifest.py",
                "--sample", "TEST_SAMPLE",
                "--skip-humann", "false",
                "--humann-bundle", "humann3.9",
                "--metaphlan-profile", "mpa4.2.2_vJan25",
                "--humann-metaphlan-profile", "mpa4.1.1_vJun23",
                "--raw-fastq", "reads.fastq",
                "--kneaddata-fastq", "reads.fastq"].execute(null, dir)
            proc.waitFor()
            assert proc.exitValue() == 0
            def m = new groovy.json.JsonSlurper().parse(new File(dir, "manifest.json"))
            assert m.software_versions.metaphlan == "4.2.2"
            assert m.software_versions.metaphlan_humann == "stub"
            assert m.software_versions.bowtie2_humann == "stub"
            assert m.software_versions.humann == "stub"
            assert m.parameters.humann_bundle == "humann3.9"
            assert m.parameters.metaphlan_profile == "mpa4.2.2_vJan25"
            assert m.parameters.humann_metaphlan_profile == "mpa4.1.1_vJun23"
        }
    }
}
